# Local demo: set true to use a local SQLite file without MySQL. Set false for MySQL.
DEMO_MODE=false
# MySQL 8+ database; create the database before starting the app.
DATABASE_URL=mysql://welfog:change-me@127.0.0.1:3306/welfog
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
TRACKING_SECRET=replace-with-a-different-stable-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-private-password

# Recommended for real sending and provider delivery/bounce webhooks.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Dedicated bulk email provider (recommended).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# SMTP fallback for ordinary messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Protect scheduled sending and mail-provider relay endpoints.
CRON_SECRET=replace-with-a-random-secret
EVENT_WEBHOOK_SECRET=replace-with-a-random-secret
INBOUND_WEBHOOK_SECRET=replace-with-a-random-secret
