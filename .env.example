# Production on Vercel with MySQL + Resend (no SMTP or AWS settings needed).
# Add these values in Vercel Project > Settings > Environment Variables.
DEMO_MODE=false
DATABASE_URL=mysql://USER:PASSWORD@PUBLIC_HOST:3306/DATABASE_NAME
APP_URL=https://YOUR-VERCEL-OR-CUSTOM-DOMAIN

# Use three different random secrets. SESSION_SECRET and TRACKING_SECRET need 32+ characters.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRACKING_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET

# Initial admin is created only when the database has no user with this username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS

# Create an API key and a signed webhook in the Resend dashboard.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SIGNING_SECRET
